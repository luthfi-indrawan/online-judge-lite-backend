APP_ENV=development
APP_PORT=8080
APP_BASE_PATH=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/online_judge?sslmode=disable
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_TTL_HOURS=24

# Seeded administrator. Set ADMIN_PASSWORD before first startup.
ADMIN_USERNAME=admin
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=

# Worker settings
WORKER_COUNT=2
SUBMISSION_QUEUE_SIZE=100
DOCKER_BIN=docker
SANDBOX_IMAGE=online-judge-sandbox:latest
SANDBOX_WORKDIR=./tmp/submissions
COMPILE_TIMEOUT_SECONDS=10
